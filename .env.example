# Copy to .env. All settings are read with the RELAY_ prefix.
RELAY_REDIS_URL=redis://:relaydev@localhost:56384/0
RELAY_DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:55437/relay
# API key for mutating endpoints. Leave empty only for local dev.
RELAY_API_KEY=change-me
# Reject new jobs with 503 when a queue's depth exceeds this.
RELAY_MAX_QUEUE_DEPTH=100000
RELAY_LOG_LEVEL=INFO
