{
  "title": "Relay",
  "uid": "relay",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Live workers",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "relay_live_workers"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Dead-letter size",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "relay_dlq_size"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Delayed jobs",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "relay_delayed_jobs"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Scheduler leaders",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(relay_scheduler_is_leader)"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Throughput (jobs/s by outcome)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(relay_jobs_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "relay_queue_depth",
          "legendFormat": "{{queue}}"
        },
        {
          "refId": "B",
          "expr": "relay_pending",
          "legendFormat": "pending {{queue}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Handler duration p50 / p95 / p99",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(relay_job_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(relay_job_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(relay_job_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Queue wait p95 by priority",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, priority) (rate(relay_queue_wait_seconds_bucket[1m])))",
          "legendFormat": "{{priority}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Retries, reclaims, deferrals (per s)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(relay_retries_total[1m]))",
          "legendFormat": "retries"
        },
        {
          "refId": "B",
          "expr": "rate(relay_reclaimed_total[1m])",
          "legendFormat": "reclaimed"
        },
        {
          "refId": "C",
          "expr": "sum(rate(relay_deferred_total[1m]))",
          "legendFormat": "deferred"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Oldest entry age",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "relay_oldest_job_age_seconds",
          "legendFormat": "{{queue}}"
        }
      ],
      "id": 10
    }
  ]
}
